{
  "realm": "agentic",
  "displayName": "agentic (desenvolvimento)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [{ "name": "equipe" }],
  "clients": [
    {
      "clientId": "open-webui",
      "name": "Open WebUI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OPEN_WEBUI_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "protocolMappers": [
        {
          "name": "audiencia ai-core",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ai-core",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "grupos",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "email": "ana@agentic.local",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Desenvolvimento",
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_DEV_PASSWORD}", "temporary": false }]
    },
    {
      "username": "bia",
      "enabled": true,
      "email": "bia@agentic.local",
      "emailVerified": true,
      "firstName": "Bia",
      "lastName": "Desenvolvimento",
      "groups": ["/equipe"],
      "credentials": [{ "type": "password", "value": "${KEYCLOAK_DEV_PASSWORD}", "temporary": false }]
    }
  ]
}
