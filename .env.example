# Copie para .env (fora do git) e preencha. Variáveis em specs/011-core-bootstrap/contracts/configuration.md; modos em
# specs/002-core-pack-runtime/contracts/installation.md. Nenhum valor real neste arquivo.

# --- Sempre ------------------------------------------------------------------------------------------------------------
# Modo (R42): vazio = só a API, com chaves de API; webui = também o Open WebUI (exige a seção "Com interface").
# COMPOSE_PROFILES=webui
# Porta do host onde a plataforma aparece (default 8000).
# AXON_HOST_PORT=8000
# Senha do Postgres da instalação (R43): `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Chave mestra (ADR-033): sela a chave de assinatura dos tokens. `openssl rand -base64 32`. Guarde-a: perdida, as
# sessões caem e é preciso `axon identity keys rotate --force`.
AXON_MASTER_KEY=
# Nome da instalação nas páginas de login (default "Axon"); logotipo opcional (SVG ou PNG montado no contêiner).
# AXON_DISPLAY_NAME=Axon
# AXON_LOGO_FILE=/run/secrets/axon/logo.svg
# Credencial do OpenRouter (spec 006); sem ela, o modelo aparece indisponível na saúde.
AXON_OPENROUTER_API_KEY=
# Chave do Qdrant (opcional; spec 101 FR-012). Se definir, use o mesmo valor nas duas linhas: o servidor lê a primeira
# (pelo docker-compose) e o pack a segunda. Em branco, o Qdrant fica sem chave, acessível só na rede do compose.
QDRANT_API_KEY=
AXON_SCOUTING_QDRANT_API_KEY=
# Números do rag_first (spec 005; defaults 20, 5 e sem limiar). O limiar é calibrado pela 105 — deixe vazio até lá.
# AXON_RAG_CANDIDATES=20
# AXON_RAG_PASSAGES=5
# AXON_RAG_MIN_SCORE=
# Fila de execuções da API (spec 008 FR-016; defaults 2, 8 e 60000 ms, provisórios).
# AXON_MAX_EXECUTIONS=2
# AXON_QUEUE_SIZE=8
# AXON_QUEUE_WAIT_MS=60000

# --- Com interface (COMPOSE_PROFILES=webui) -----------------------------------------------------------------------------
# O login é o da própria plataforma (spec 012, ADR-030): contas criadas por `axon users create` (ou pelo admin
# inicial abaixo), clientes em config/identity.yaml.
# AXON_IDENTITY_ENABLED=true
# Endereço que o navegador usa para a plataforma (o emissor dos tokens; default http://localhost:<AXON_HOST_PORT>).
# AXON_PUBLIC_URL=http://localhost:8000
# Segredo do cliente open-webui (`openssl rand -hex 24`): a plataforma e o Open WebUI leem esta mesma variável.
# AXON_IDENTITY_SECRET_OPEN_WEBUI=
# Chave de sessão do Open WebUI (`openssl rand -hex 24`) e duração da sessão dele (menor que os 30 dias da plataforma).
# WEBUI_SECRET_KEY=
# OPEN_WEBUI_SESSION_EXPIRES_IN=29d
# OPEN_WEBUI_HOST_PORT=3000
# Admin inicial (opcional; só vale com zero contas): a senha vai num arquivo em secrets/, nunca numa variável.
#   printf '%s' 'uma-senha-longa' > secrets/bootstrap-admin-password
# AXON_BOOTSTRAP_ADMIN_USERNAME=admin
# AXON_BOOTSTRAP_ADMIN_EMAIL=admin@exemplo.org
# AXON_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/axon/bootstrap-admin-password
# Login com Google (opcional; só para contas cadastradas — o e-mail verificado precisa bater com uma conta ativa).
# No console do Google, o endereço de retorno autorizado é <AXON_PUBLIC_URL>/oauth2/google/callback.
# AXON_GOOGLE_CLIENT_ID=
# AXON_GOOGLE_CLIENT_SECRET=
# AXON_GOOGLE_HOSTED_DOMAIN=
# Liga ou desliga o Google pela instalação (vence o ajuste da administração); sem ela, ligado se configurado.
# AXON_GOOGLE_LOGIN=true
# Proxies cujos X-Forwarded-* valem (IPs ou redes CIDR, separados por vírgula).
# AXON_TRUSTED_PROXIES=
# Senha de desenvolvimento das contas ana e bia (scripts/dev-users.sh e scripts/check-webui.py).
# DEV_USERS_PASSWORD=
