# Copie para .env (fora do git) e preencha. Variáveis em specs/011-core-bootstrap/contracts/configuration.md.
AI_CORE_PROFILE=memory
# Porta do host onde o serviço aparece (o docker-compose a lê; default 8000).
# AI_CORE_HOST_PORT=8000
# Chave de desenvolvimento do perfil memory, no formato aic_<16 hex>_<segredo>:
#   echo "aic_$(openssl rand -hex 8)_$(openssl rand -hex 16)"
AI_CORE_DEV_API_KEY=
# Credencial do OpenRouter (spec 006); sem ela, o modelo aparece indisponível na saúde.
AI_CORE_OPENROUTER_API_KEY=
# Chave do Qdrant (opcional; spec 101 FR-012). Se definir, use o mesmo valor nas duas linhas: o servidor lê a primeira
# (pelo docker-compose) e o pack a segunda. Em branco, o Qdrant fica sem chave, acessível só na rede do compose.
QDRANT_API_KEY=
AI_SCOUTING_QDRANT_API_KEY=
# Números do rag_first (spec 005; defaults 20, 5 e sem limiar). O limiar é calibrado pela 105 — deixe vazio até lá.
# AI_CORE_RAG_CANDIDATES=20
# AI_CORE_RAG_PASSAGES=5
# AI_CORE_RAG_MIN_SCORE=
