# Copie para .env (fora do git) e preencha. Variáveis em specs/011-core-bootstrap/contracts/configuration.md.
AI_CORE_PROFILE=memory
# Porta do host onde o serviço aparece (o docker-compose a lê; default 8000).
# AI_CORE_HOST_PORT=8000
# Chave de desenvolvimento do perfil memory, no formato aic_<16 hex>_<segredo>:
#   echo "aic_$(openssl rand -hex 8)_$(openssl rand -hex 16)"
AI_CORE_DEV_API_KEY=
# Credencial do OpenRouter (spec 006); sem ela, o modelo aparece indisponível na saúde.
AI_CORE_OPENROUTER_API_KEY=
# Chave do Qdrant (opcional; spec 101 FR-012). Se definir, use o mesmo valor nas duas linhas: o servidor lê a primeira
# (pelo docker-compose) e o pack a segunda. Em branco, o Qdrant fica sem chave, acessível só na rede do compose.
QDRANT_API_KEY=
AI_SCOUTING_QDRANT_API_KEY=
# Números do rag_first (spec 005; defaults 20, 5 e sem limiar). O limiar é calibrado pela 105 — deixe vazio até lá.
# AI_CORE_RAG_CANDIDATES=20
# AI_CORE_RAG_PASSAGES=5
# AI_CORE_RAG_MIN_SCORE=
# Fila de execuções da API (spec 008 FR-016; defaults 2, 8 e 60000 ms, provisórios).
# AI_CORE_MAX_EXECUTIONS=2
# AI_CORE_QUEUE_SIZE=8
# AI_CORE_QUEUE_WAIT_MS=60000

# --- Perfil webui: Open WebUI com SSO num Keycloak de desenvolvimento (spec 002 R37–R39) ----------------------------
# docker compose --profile webui up -d  →  http://localhost:3000 (entre como ana ou bia; a bia é do grupo equipe).
# O core verifica o access token que o Open WebUI repassa: o emissor é o endereço que o navegador vê; as chaves, o da
# rede interna.
# AI_CORE_OIDC_ISSUER=http://localhost:8180/realms/agentic
# AI_CORE_OIDC_AUDIENCE=ai-core
# AI_CORE_OIDC_JWKS_URL=http://keycloak:8080/realms/agentic/protocol/openid-connect/certs
# AI_CORE_OIDC_SUBJECT_CLAIM=preferred_username
# Segredos de desenvolvimento (gere com `openssl rand -hex 24`): o do cliente open-webui no Keycloak e no Open WebUI, a
# senha de ana e bia, o administrador do Keycloak e a chave de sessão do Open WebUI.
# OPEN_WEBUI_OIDC_SECRET=
# KEYCLOAK_DEV_PASSWORD=
# KEYCLOAK_ADMIN_PASSWORD=
# WEBUI_SECRET_KEY=
# Portas do host (defaults 3000 e 8180; o redirect do cliente no realm usa localhost:3000).
# OPEN_WEBUI_HOST_PORT=3000
# KEYCLOAK_HOST_PORT=8180
