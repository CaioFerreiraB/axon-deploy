# O ambiente desta instalação (spec 002 FR-034; ADR-042). No Portainer, estas são as variáveis da stack; localmente,
# copie para .env (fora do git). Nenhum valor real neste arquivo. Variáveis da plataforma em
# specs/011-core-bootstrap/contracts/configuration.md do axon.

# --- Sempre ------------------------------------------------------------------------------------------------------------
# Modo: vazio = só a API (chaves de API); webui, console ou webui,console acrescentam as interfaces.
COMPOSE_PROFILES=webui,console
# A rede do proxy reverso (docker network create <nome>); o proxy alcança axon-console, axon-chat e axon-api nela.
AXON_PROXY_NETWORK=proxy
# Senha do Postgres: `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Chave mestra (ADR-033), que sela a chave de assinatura dos tokens: `openssl rand -base64 32`. Guarde-a: perdida, as
# sessões caem e é preciso `axon identity keys rotate --force`.
AXON_MASTER_KEY=
# O endereço que o navegador usa para a plataforma: com a console, o domínio dela.
AXON_PUBLIC_URL=https://axon.exemplo.org
# Credencial do provedor de modelos (spec 006); sem ela, o modelo aparece indisponível na saúde.
AXON_OPENROUTER_API_KEY=
# Nome da instalação nas páginas de login (default "Axon"); logotipo em config/ (AXON_LOGO_FILE=/etc/axon/logo.svg).
# AXON_DISPLAY_NAME=Axon
# AXON_LOGO_FILE=

# --- Com interface (webui ou console) -----------------------------------------------------------------------------------
# O login é o da própria plataforma (spec 012). O primeiro administrador, no console do contêiner axon:
#   axon users create <nome> --email <e-mail> --group admin
AXON_IDENTITY_ENABLED=true
# O endereço do chat (perfil webui).
AXON_CHAT_URL=https://chat.exemplo.org
# Segredo do cliente open-webui: `openssl rand -hex 24` (a plataforma e o Open WebUI leem esta mesma variável).
AXON_IDENTITY_SECRET_OPEN_WEBUI=
# Chave de sessão do Open WebUI: `openssl rand -hex 24`.
WEBUI_SECRET_KEY=
# OPEN_WEBUI_SESSION_EXPIRES_IN=29d

# --- Opcionais -------------------------------------------------------------------------------------------------------------
# Login com Google, só para contas cadastradas; retorno autorizado: <AXON_PUBLIC_URL>/oauth2/google/callback.
# AXON_GOOGLE_CLIENT_ID=
# AXON_GOOGLE_CLIENT_SECRET=
# AXON_GOOGLE_HOSTED_DOMAIN=
# Langfuse (tudo ou nada); com a console, prefira configurar pela tela.
# AXON_LANGFUSE_HOST=
# AXON_LANGFUSE_PUBLIC_KEY=
# AXON_LANGFUSE_SECRET_KEY=

# --- Só no compose.local.yml -------------------------------------------------------------------------------------------
# PACKS=
# AXON_HOST_PORT=8000
# CONSOLE_HOST_PORT=8080
# OPEN_WEBUI_HOST_PORT=3000
